# Copy to .env.saas and generate three different random values.
CONTROL_POSTGRES_PASSWORD=replace-with-long-random-value
APP_SECRET=replace-with-at-least-32-random-characters
APP_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# AWS production: use aws after attaching the documented EC2 IAM role.
# Local/first test: fernet keeps database passwords encrypted at rest.
SECRETS_BACKEND=fernet
AWS_REGION=ap-south-1
AWS_SECRET_PREFIX=postgres-cdc

COOKIE_SECURE=true
ALLOWED_HOSTS=*
# Keep broad private-host access off; allow only explicitly trusted RDS endpoints.
ALLOW_PRIVATE_DATABASES=false
PRIVATE_DATABASE_HOST_ALLOWLIST=
